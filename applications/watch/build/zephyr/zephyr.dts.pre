/ {
 aliases {
  qdec0 = &qdec;
  dma-0 = &dma0;
  rtc = &rtc;
  sdhc0 = &sdhc0;
  ext-amp = &ext_amp;
    };

 gpio_keys: gpio_keys{
  compatible = "realtek,gpio-keys";
  debounce-interval-ms = <30>;
  key1: key1{
   gpios = <&gpioa 23 ((1 << 0) | (1 << 4) | (1 << 7))>;
   label = "key1";
   key,id = <100>;
   status = "okay";
  };
  key2: key2{
   gpios = <&gpioa 0 ((1 << 0) | (1 << 4))>;
   label = "key2";
   key,id = <101>;
   status = "disabled";
  };
  key3: key3{
   gpios = <&gpioa 24 ((1 << 0) | (1 << 4))>;
   label = "key3";
   key,id = <102>;
   status = "disabled";
  };
 };

 gpio_output{
  compatible = "gpio-leds";
  ext_amp: ext_amp{

   gpios = <&gpioa 20 (0 << 0)>;
   label = "ext amp control pin";
  };
 };
