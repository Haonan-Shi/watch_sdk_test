 partition_userdata2: partition@ad1000{
  label = "realtek-userdata2";
  reg = <0xAD1000 ((5) * 1024 * 1024)>;
  read-only;
  flash_disk1: flash_disk1 {
   compatible = "zephyr,flash-disk";
   partition = <&partition_userdata2>;
   disk-name = "ROMFS";
   cache-size = <0>;
   sector-size = <512>;
   status = "disabled";
  };
 };
};



/delete-node/ &dtcm;
/delete-node/ &heap_dtcm;
/delete-node/ &sram;
/delete-node/ &heap_sram;
/delete-node/ &itcm;
/delete-node/ &heap_itcm;
/delete-node/ &dsp_share_ram;
